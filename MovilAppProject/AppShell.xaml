<?xml version="1.0" encoding="UTF-8" ?>
<!-- Navegación principal. La barra del Shell se oculta porque en Windows aparece arriba; en su lugar se usa BarraInferior. -->
<Shell
    x:Class="MovilAppProject.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:MovilAppProject.Views"
    Title="GastoFácil"
    Shell.FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="False"
    Shell.BackgroundColor="{StaticResource ColorFondo}"
    Shell.TabBarIsVisible="False">

    <TabBar>
        <ShellContent
            Title="Inicio"
            ContentTemplate="{DataTemplate views:vInicio}"
            Route="vInicio" />

        <ShellContent
            Title="Regla"
            ContentTemplate="{DataTemplate views:vRegla}"
            Route="vRegla" />

        <ShellContent
            Title="Estadísticas"
            ContentTemplate="{DataTemplate views:vEstadisticas}"
            Route="vEstadisticas" />

        <!-- Pestaña IA (recomendaciones) -->
        <ShellContent
            Title="IA"
            ContentTemplate="{DataTemplate views:vRecomendaciones}"
            Route="vRecomendaciones" />

        <ShellContent
            Title="Ajustes"
            ContentTemplate="{DataTemplate views:vAjustes}"
            Route="vAjustes" />
    </TabBar>

</Shell>
