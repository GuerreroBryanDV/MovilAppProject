<?xml version="1.0" encoding="utf-8" ?>
<!--
    vRegla.xaml  (según el mockup "Regla 50/40/10")
    Página base creada en PB04 (MAP-4) para la navegación del AppShell.
    PB12 · Panel de la regla: % real, meta, dinero restante y barra por grupo.
    PB13 · Semáforo por grupo (V12): etiqueta En meta / Cerca / Fuera de meta.
    Los datos salen de ReglaPresupuestoService (PB11).
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:servicios="clr-namespace:MovilAppProject.Services"
             x:Class="MovilAppProject.Views.vRegla"
             ControlTemplate="{StaticResource PlantillaConBarra}"
             Title="Regla">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">

            <!-- ===== Encabezado: "Regla 50/40/10"  ·  "Noviembre 2026" ===== -->
            <Grid ColumnDefinitions="*,Auto">
                <Label x:Name="lblTitulo"
                       Text="Regla 50/40/10"
                       Style="{StaticResource TituloPagina}"
                       Grid.Column="0"/>
                <Label x:Name="lblMes"
                       Style="{StaticResource TextoSecundario}"
                       VerticalOptions="Center"
                       Grid.Column="1"/>
            </Grid>

            <!-- "Ingresos del mes: $1.000,00" -->
            <Label x:Name="lblIngresos"
                   Style="{StaticResource TextoSecundario}"/>

            <!-- V11: sin ingresos en el mes no se calculan porcentajes -->
            <Border x:Name="brdSinIngresos"
                    Style="{StaticResource Aviso}"
                    IsVisible="False">
                <Label x:Name="lblSinIngresos"
                       FontSize="13"
                       TextColor="{StaticResource Primary}"
                       HorizontalTextAlignment="Center"/>
            </Border>

            <!-- ===== Una tarjeta por grupo ===== -->
            <VerticalStackLayout x:Name="slGrupos"
                                 Spacing="12">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="servicios:ResumenGrupo">
                        <Border Style="{StaticResource Tarjeta}">
                            <VerticalStackLayout Spacing="2">

                                <!-- Nombre del grupo (con su color) y semáforo -->
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding Nombre}"
                                           Style="{StaticResource GrupoNecesidades}"
                                           FontSize="16"
                                           VerticalOptions="Center"
                                           Grid.Column="0">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label"
                                                         Binding="{Binding Nombre}"
                                                         Value="Ahorro e inversión">
                                                <Setter Property="TextColor" Value="{StaticResource ColorAhorro}"/>
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label"
                                                         Binding="{Binding Nombre}"
                                                         Value="Lujos">
                                                <Setter Property="TextColor" Value="{StaticResource ColorLujos}"/>
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>

                                    <!-- PB13 · Semáforo (V12): verde por defecto -->
                                    <Border Padding="10,3"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 10"
                                            VerticalOptions="Center"
                                            BackgroundColor="{StaticResource ColorEnMetaFondo}"
                                            Grid.Column="1">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border"
                                                         Binding="{Binding Semaforo}"
                                                         Value="{x:Static servicios:EstadoSemaforo.Amarillo}">
                                                <Setter Property="BackgroundColor" Value="{StaticResource ColorCercaFondo}"/>
                                            </DataTrigger>
                                            <DataTrigger TargetType="Border"
                                                         Binding="{Binding Semaforo}"
                                                         Value="{x:Static servicios:EstadoSemaforo.Rojo}">
                                                <Setter Property="BackgroundColor" Value="{StaticResource ColorFueraMetaFondo}"/>
                                            </DataTrigger>
                                        </Border.Triggers>

                                        <Label Text="{Binding TextoSemaforo}"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource ColorIngreso}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label"
                                                             Binding="{Binding Semaforo}"
                                                             Value="{x:Static servicios:EstadoSemaforo.Amarillo}">
                                                    <Setter Property="TextColor" Value="{StaticResource ColorAcento}"/>
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label"
                                                             Binding="{Binding Semaforo}"
                                                             Value="{x:Static servicios:EstadoSemaforo.Rojo}">
                                                    <Setter Property="TextColor" Value="{StaticResource ColorGasto}"/>
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Border>
                                </Grid>

                                <!-- % real sobre los ingresos: "40 %" -->
                                <Label Text="{Binding PorcentajeReal, StringFormat='{0:N0} %'}"
                                       FontFamily="OpenSansSemibold"
                                       FontAttributes="Bold"
                                       FontSize="30"
                                       TextColor="{StaticResource Primary}"/>

                                <!-- "de 50 % · quedan $100,00 · tope máximo" -->
                                <Label Text="{Binding TextoDetalle}"
                                       Style="{StaticResource TextoSecundario}"/>

                                <!-- Barra: fondo, parte llena (% real) y marca de la meta -->
                                <AbsoluteLayout HeightRequest="14"
                                                Margin="0,8,0,0">
                                    <BoxView AbsoluteLayout.LayoutBounds="0,4,1,6"
                                             AbsoluteLayout.LayoutFlags="WidthProportional"
                                             Color="{StaticResource ColorCampo}"
                                             CornerRadius="3"/>

                                    <BoxView AbsoluteLayout.LayoutBounds="{Binding RectBarra}"
                                             AbsoluteLayout.LayoutFlags="WidthProportional"
                                             Color="{StaticResource ColorNecesidades}"
                                             CornerRadius="3">
                                        <BoxView.Triggers>
                                            <DataTrigger TargetType="BoxView"
                                                         Binding="{Binding Nombre}"
                                                         Value="Ahorro e inversión">
                                                <Setter Property="Color" Value="{StaticResource ColorAhorro}"/>
                                            </DataTrigger>
                                            <DataTrigger TargetType="BoxView"
                                                         Binding="{Binding Nombre}"
                                                         Value="Lujos">
                                                <Setter Property="Color" Value="{StaticResource ColorLujos}"/>
                                            </DataTrigger>
                                        </BoxView.Triggers>
                                    </BoxView>

                                    <BoxView AbsoluteLayout.LayoutBounds="{Binding RectMeta}"
                                             AbsoluteLayout.LayoutFlags="XProportional"
                                             Color="{StaticResource Primary}"/>
                                </AbsoluteLayout>

                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!-- ===== "Cumplimiento del mes  ·  1 de 3 grupos" ===== -->
            <Border x:Name="brdCumplimiento"
                    BackgroundColor="{StaticResource Secondary}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 12"
                    Padding="16">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Cumplimiento del mes"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}"
                           Grid.Column="0"/>
                    <Label x:Name="lblCumplimiento"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}"
                           Grid.Column="1"/>
                </Grid>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
