<?xml version="1.0" encoding="utf-8" ?>
<!--
    vInicio.xaml
    Página base creada en PB04 (MAP-4) para la navegación del AppShell.
    Su contenido se implementa en: PB07 (vInicio / saldo actual)
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MovilAppProject.Views.vInicio"
             Title="Inicio">

    <VerticalStackLayout Padding="20" Spacing="15">
        <Label Text="Inicio"
               Style="{StaticResource TituloPagina}"/>
        <Label Text="En construcción"
               Style="{StaticResource TextoSecundario}"
               HorizontalOptions="Center"/>
    </VerticalStackLayout>

</ContentPage>
