<?xml version="1.0" encoding="utf-8" ?>
<!--
    vAjustes.xaml  (PB17 · MAP-17 · Pantalla de ajustes)
    - Bloqueo de la app: al activarlo pide Nuevo PIN y Confirmar PIN (V16, V17).
    - Recordatorios: interruptor; al activarlo se pide texto, hora y frecuencia (PB20, V20-V23).
    - Regla 50/40/10: acceso a los perfiles de porcentajes (vPorcentajes, PB15).
    Los valores se guardan en Preferences y se conservan al cerrar la app.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MovilAppProject.Views.vAjustes"
             ControlTemplate="{StaticResource PlantillaConBarra}"
             Title="Ajustes">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <!-- Título -->
            <Label Text="Ajustes"
                   Style="{StaticResource TituloPagina}"/>
            <Label Text="Seguridad, recordatorios y perfil de la regla."
                   Style="{StaticResource TextoSecundario}"/>

            <!-- ===== Seguridad: bloqueo con PIN ===== -->
            <Border Style="{StaticResource Tarjeta}">
                <VerticalStackLayout Spacing="10">

                    <Label Text="Seguridad" Style="{StaticResource EtiquetaCampo}" FontSize="15"/>
                    <Label x:Name="lblUsuarioActual" Style="{StaticResource TextoSecundario}"/>

                    <!-- D20: cambiar el PIN (solo con el bloqueo activo; pide el PIN actual) -->
                    <Button x:Name="btnCambiarPin"
                            Text="Cambiar PIN"
                            Clicked="btnCambiarPin_Clicked"
                            Style="{StaticResource BotonSecundario}"/>
                    <!-- Formulario del PIN: aparece al activar el bloqueo o al cambiar el PIN -->
                    <VerticalStackLayout x:Name="slPin"
                                         Spacing="8"
                                         IsVisible="False">

                        <Label Text="Nuevo PIN"
                               Style="{StaticResource EtiquetaCampo}"/>
                        <Border Style="{StaticResource CampoFormulario}">
                            <Entry x:Name="txtPin"
                                   Placeholder="4 dígitos"
                                   IsPassword="True"
                                   Keyboard="Numeric"
                                   MaxLength="4"/>
                        </Border>

                        <Label Text="Confirmar PIN"
                               Style="{StaticResource EtiquetaCampo}"/>
                        <Border Style="{StaticResource CampoFormulario}">
                            <Entry x:Name="txtConfirmarPin"
                                   Placeholder="Repite el PIN"
                                   IsPassword="True"
                                   Keyboard="Numeric"
                                   MaxLength="4"/>
                        </Border>

                        <Grid ColumnSpacing="10"
                              Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="btnCancelarPin"
                                    Text="Cancelar"
                                    Clicked="btnCancelarPin_Clicked"
                                    Style="{StaticResource BotonSecundario}"
                                    Grid.Column="0"/>
                            <Button x:Name="btnGuardarPin"
                                    Text="Guardar PIN"
                                    Clicked="btnGuardarPin_Clicked"
                                    Style="{StaticResource BotonPrimario}"
                                    Grid.Column="1"/>
                        </Grid>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <!-- ===== Recordatorios ===== -->
            <Border Style="{StaticResource Tarjeta}">
                <VerticalStackLayout Spacing="10">

                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <VerticalStackLayout Grid.Column="0"
                                         VerticalOptions="Center">
                        <Label Text="Recordatorios"
                               Style="{StaticResource EtiquetaCampo}"
                               FontSize="15"/>
                        <Label Text="Avisos para registrar tus gastos y aportes de ahorro."
                               Style="{StaticResource TextoSecundario}"/>
                    </VerticalStackLayout>

                    <Switch x:Name="swRecordatorios"
                            Toggled="swRecordatorios_Toggled"
                            OnColor="{StaticResource ColorAhorro}"
                            VerticalOptions="Center"
                            Grid.Column="1"/>
                </Grid>

                    <!-- PB20: recordatorio programado ("Registrar ahorro · 20:00 · Semanal") -->
                    <Label x:Name="lblRecordatorioActual"
                           Style="{StaticResource TextoSecundario}"
                           IsVisible="False"/>

                    <!-- PB20 · Formulario del recordatorio: solo aparece al activar el interruptor -->
                    <VerticalStackLayout x:Name="slRecordatorio"
                                         Spacing="8"
                                         IsVisible="False">

                        <!-- V20: de 3 a 50 caracteres -->
                        <Label Text="Texto del recordatorio"
                               Style="{StaticResource EtiquetaCampo}"/>
                        <Border Style="{StaticResource CampoFormulario}">
                            <Entry x:Name="txtRecordatorio"
                                   Placeholder="Ej. Registrar ahorro"
                                   MaxLength="50"/>
                        </Border>

                        <!-- V21: por defecto 20:00 -->
                        <Label Text="Hora"
                               Style="{StaticResource EtiquetaCampo}"/>
                        <Border Style="{StaticResource CampoFormulario}">
                            <TimePicker x:Name="tpHora"
                                        Format="HH:mm"/>
                        </Border>

                        <!-- V22: Diaria / Semanal / Mensual -->
                        <Label Text="Frecuencia"
                               Style="{StaticResource EtiquetaCampo}"/>
                        <Border Style="{StaticResource CampoFormulario}">
                            <Picker x:Name="pkFrecuencia"
                                    Title="Selecciona la frecuencia"/>
                        </Border>

                        <Grid ColumnSpacing="10"
                              Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="btnCancelarRecordatorio"
                                    Text="Cancelar"
                                    Clicked="btnCancelarRecordatorio_Clicked"
                                    Style="{StaticResource BotonSecundario}"
                                    Grid.Column="0"/>
                            <Button x:Name="btnGuardarRecordatorio"
                                    Text="Guardar"
                                    Clicked="btnGuardarRecordatorio_Clicked"
                                    Style="{StaticResource BotonPrimario}"
                                    Grid.Column="1"/>
                        </Grid>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <!-- ===== Regla 50/40/10 ===== -->
            <Border Style="{StaticResource Tarjeta}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Regla 50/40/10"
                           Style="{StaticResource EtiquetaCampo}"
                           FontSize="15"/>
                    <Label Text="Elige o personaliza los porcentajes de tu regla."
                           Style="{StaticResource TextoSecundario}"/>
                    <Button x:Name="btnPorcentajes"
                            Text="Perfiles de porcentajes"
                            Clicked="btnPorcentajes_Clicked"
                            Style="{StaticResource BotonSecundario}"/>
                </VerticalStackLayout>
            </Border>

            <!-- ===== Cuenta: inactivar (borrado lógico) ===== -->
            <Border Style="{StaticResource Tarjeta}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Cuenta"
                           Style="{StaticResource EtiquetaCampo}"
                           FontSize="15"/>
                    <Label Text="Inactivar la cuenta cierra tu sesión y permite registrar otro usuario. Tus datos se conservan en el historial."
                           Style="{StaticResource TextoSecundario}"/>
                    <Button x:Name="btnInactivarCuenta"
                            Text="Inactivar cuenta"
                            Clicked="btnInactivarCuenta_Clicked"
                            Style="{StaticResource BotonSecundario}"/>
                </VerticalStackLayout>
            </Border>        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
