<?xml version="1.0" encoding="utf-8" ?>
<!--
    vAjustes.xaml
    Página base creada en PB04 (MAP-4) para la navegación del AppShell.
    Su contenido se implementa en: PB17 (vAjustes)
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MovilAppProject.Views.vAjustes"
             ControlTemplate="{StaticResource PlantillaConBarra}"
             Title="Ajustes">

    <VerticalStackLayout Padding="20" Spacing="15">
        <Label Text="Ajustes"
               Style="{StaticResource TituloPagina}"/>
        <Label Text="En construcción"
               Style="{StaticResource TextoSecundario}"
               HorizontalOptions="Center"/>
    </VerticalStackLayout>

</ContentPage>
