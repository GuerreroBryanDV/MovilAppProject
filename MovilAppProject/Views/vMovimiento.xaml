<?xml version="1.0" encoding="utf-8" ?>
<!--
    vMovimiento.xaml  (PB05 · MAP-5 · HU1 Registrar gasto)
    Pantalla "Nuevo movimiento" según el mockup.
    Se abre desde el botón "+ Nuevo" de vInicio.
    PB09: al tocar un movimiento en vInicio se abre en modo "Editar movimiento".
    PB10: en modo edición aparece el botón "Eliminar movimiento".
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MovilAppProject.Views.vMovimiento"
             Title="Nuevo movimiento">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <!-- Título -->
            <Label x:Name="lblTitulo"
                   Text="Nuevo movimiento"
                   Style="{StaticResource TituloPagina}"/>

            <!-- Tipo: Gasto | Ingreso (V01) -->
            <Border Style="{StaticResource CampoFormulario}"
                    Padding="4">
                <Grid ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="btnGasto"
                            Text="Gasto"
                            Clicked="btnGasto_Clicked"
                            Style="{StaticResource BotonPrimario}"
                            Grid.Column="0"/>
                    <Button x:Name="btnIngreso"
                            Text="Ingreso"
                            Clicked="btnIngreso_Clicked"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource Primary}"
                            CornerRadius="12"
                            Grid.Column="1"/>
                </Grid>
            </Border>

            <!-- Monto (V02, V03, V04) -->
            <Label Text="Monto"
                   Style="{StaticResource EtiquetaCampo}"/>
            <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Label Text="$"
                       Style="{StaticResource MontoGrande}"
                       VerticalOptions="Center"
                       Grid.Column="0"/>
                <Entry x:Name="txtMonto"
                       Placeholder="0,00"
                       Keyboard="Numeric"
                       MaxLength="9"
                       FontSize="34"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Primary}"
                       Grid.Column="1"/>
            </Grid>

            <!-- Categoría (V05): se oculta cuando el tipo es Ingreso -->
            <VerticalStackLayout x:Name="slCategoria"
                                 Spacing="6">
                <Label Text="Categoría"
                       Style="{StaticResource EtiquetaCampo}"/>
                <Border Style="{StaticResource CampoFormulario}">
                    <Picker x:Name="pkCategoria"
                            Title="Selecciona una categoría"
                            SelectedIndexChanged="pkCategoria_SelectedIndexChanged"/>
                </Border>

                <!-- Aviso amarillo: "Se contará en Lujos." -->
                <Border x:Name="brdAviso"
                        Style="{StaticResource Aviso}"
                        IsVisible="False">
                    <Label x:Name="lblAviso"
                           FontSize="13"
                           TextColor="{StaticResource Primary}"/>
                </Border>
            </VerticalStackLayout>

            <!-- Fecha (V06): no se permiten fechas futuras -->
            <Label Text="Fecha"
                   Style="{StaticResource EtiquetaCampo}"/>
            <Border Style="{StaticResource CampoFormulario}">
                <DatePicker x:Name="dpFecha"
                            Format="dd/MM/yyyy"/>
            </Border>

            <!-- Nota opcional (V07): máximo 100 caracteres -->
            <Label Text="Nota (opcional)"
                   Style="{StaticResource EtiquetaCampo}"/>
            <Border Style="{StaticResource CampoFormulario}">
                <Entry x:Name="txtNota"
                       Placeholder="Ej. Cine con amigos"
                       MaxLength="100"/>
            </Border>

            <!-- Guardar -->
            <Button x:Name="btnGuardar"
                    Text="Guardar gasto"
                    Clicked="btnGuardar_Clicked"
                    Style="{StaticResource BotonPrimario}"
                    Margin="0,10,0,0"/>

            <!-- PB10: solo visible al editar un movimiento -->
            <Button x:Name="btnEliminar"
                    Text="Eliminar movimiento"
                    Clicked="btnEliminar_Clicked"
                    Style="{StaticResource BotonSecundario}"
                    IsVisible="False"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
