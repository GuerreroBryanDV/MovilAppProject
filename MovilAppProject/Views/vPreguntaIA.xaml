<?xml version="1.0" encoding="utf-8" ?>
<!-- Componente para preguntar a la IA (PB23); va dentro de vRecomendaciones. -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MovilAppProject.Views.vPreguntaIA">

    <VerticalStackLayout Spacing="8">

        <Label Text="Pregúntale a la IA"
               Style="{StaticResource EtiquetaCampo}"
               FontSize="15"/>

        <!-- Respuesta de la IA (arriba, como en un chat) -->
        <Border x:Name="brdRespuesta"
                Style="{StaticResource Tarjeta}"
                IsVisible="False">
            <VerticalStackLayout Spacing="4">
                <Label x:Name="lblPreguntaHecha"
                       Style="{StaticResource EtiquetaCampo}"/>
                <Label x:Name="lblRespuesta"
                       FontSize="14"
                       TextColor="{StaticResource Primary}"/>
            </VerticalStackLayout>
        </Border>

        <!-- Mientras espera la respuesta -->
        <HorizontalStackLayout x:Name="slEsperando"
                               Spacing="8"
                               IsVisible="False">
            <ActivityIndicator IsRunning="True"
                               Color="{StaticResource Primary}"
                               HeightRequest="20"
                               WidthRequest="20"/>
            <Label Text="Consultando a la IA..."
                   Style="{StaticResource TextoSecundario}"
                   VerticalOptions="Center"/>
        </HorizontalStackLayout>

        <!-- Pregunta + botón Enviar (abajo, para la siguiente pregunta) -->
        <Border Style="{StaticResource Tarjeta}"
                Padding="10,4">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Entry x:Name="txtPregunta"
                       Placeholder="¿Cómo puedo gastar menos en comida?"
                       MaxLength="200"
                       Completed="btnEnviar_Clicked"
                       Grid.Column="0"/>
                <Button x:Name="btnEnviar"
                        Text="Enviar"
                        Clicked="btnEnviar_Clicked"
                        Style="{StaticResource BotonPrimario}"
                        HeightRequest="40"
                        Padding="14,0"
                        VerticalOptions="Center"
                        Grid.Column="1"/>
            </Grid>
        </Border>

    </VerticalStackLayout>

</ContentView>
